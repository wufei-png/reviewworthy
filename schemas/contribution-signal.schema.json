{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewworthy.dev/schemas/contribution-signal.schema.json",
  "title": "Reviewworthy Contribution Signal 0.3",
  "type": "object",
  "required": ["signal_version", "record_type", "claim_type", "lifecycle", "reference", "evidence", "authority"],
  "properties": {
    "signal_version": { "const": "0.3" },
    "record_type": { "enum": ["issue", "pull_request", "discussion", "local_evidence"] },
    "claim_type": { "enum": ["bug_report", "maintainer_request", "accepted_proposal", "reproducible_evidence"] },
    "lifecycle": { "enum": ["pending", "confirmed", "rejected", "expired"] },
    "reference": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "authority": {
      "type": "object",
      "required": ["kind", "actor", "asserted_at"],
      "properties": {
        "kind": { "enum": ["contributor", "maintainer", "repository"] },
        "actor": { "type": "string" },
        "asserted_at": { "type": "string" }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["status", "provider", "reference", "record_type", "verified_at"],
      "properties": {
        "status": { "enum": ["verified", "local_only"] },
        "provider": { "enum": ["github", "local"] },
        "reference": { "type": "string" },
        "record_type": { "enum": ["issue", "pull_request", "discussion", "local_evidence"] },
        "verified_at": { "type": "string", "minLength": 1 },
        "host": { "const": "github.com" },
        "repository": { "type": "string" },
        "repository_id": { "type": "integer", "exclusiveMinimum": 0 },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string" },
        "visibility": { "type": "string" },
        "state": { "type": ["string", "null"] },
        "state_reason": { "type": ["string", "null"] },
        "locked": { "type": ["boolean", "null"] },
        "labels": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "publication_subject_id": { "type": "string", "minLength": 1 },
    "publication": {
      "type": "object",
      "required": ["operation_id", "repo", "title", "body"],
      "properties": {
        "operation_id": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "claim_type": { "const": "reproducible_evidence" } } },
      "then": { "properties": { "evidence": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "record_type": { "const": "local_evidence" } } },
      "then": {
        "properties": {
          "claim_type": { "const": "reproducible_evidence" },
          "verification": {
            "properties": {
              "status": { "const": "local_only" },
              "provider": { "const": "local" },
              "record_type": { "const": "local_evidence" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "reference": { "minLength": 1 },
          "verification": {
            "properties": {
              "status": { "const": "verified" },
              "provider": { "const": "github" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": { "const": "confirmed" },
          "claim_type": { "enum": ["maintainer_request", "accepted_proposal"] }
        },
        "required": ["lifecycle", "claim_type"]
      },
      "then": {
        "properties": {
          "authority": {
            "properties": {
              "kind": { "enum": ["maintainer", "repository"] },
              "actor": { "minLength": 1 },
              "asserted_at": { "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "record_type": { "const": "issue" } }, "required": ["record_type"] },
      "then": { "properties": { "verification": { "properties": { "record_type": { "const": "issue" } } } } }
    },
    {
      "if": { "properties": { "record_type": { "const": "pull_request" } }, "required": ["record_type"] },
      "then": { "properties": { "verification": { "properties": { "record_type": { "const": "pull_request" } } } } }
    },
    {
      "if": { "properties": { "record_type": { "const": "discussion" } }, "required": ["record_type"] },
      "then": { "properties": { "verification": { "properties": { "record_type": { "const": "discussion" } } } } }
    }
  ],
  "dependentRequired": {
    "publication": ["publication_subject_id"],
    "publication_subject_id": ["publication"]
  },
  "additionalProperties": false
}
