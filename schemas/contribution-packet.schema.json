{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewworthy.dev/schemas/contribution-packet.schema.json",
  "title": "Reviewworthy Contribution Packet",
  "type": "object",
  "required": [
    "packet_version",
    "contribution_id",
    "repository",
    "entry",
    "basis",
    "contract",
    "policy",
    "review",
    "ai_assistance",
    "diff",
    "verification",
    "ownership",
    "snapshots",
    "results",
    "understanding",
    "narrative"
  ],
  "properties": {
    "packet_version": { "const": "0.3" },
    "contribution_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "repository": {
      "type": "object",
      "required": ["provider", "host", "owner", "name", "default_branch"],
      "properties": {
        "provider": { "const": "github" },
        "host": { "const": "github.com" },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "repository_id": { "type": ["integer", "null"], "exclusiveMinimum": 0 },
        "default_branch": { "type": "string", "minLength": 1 },
        "base_sha": { "type": "string" }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["mode"],
      "properties": { "mode": { "enum": ["issue-backed", "discovery"] } },
      "additionalProperties": true
    },
    "basis": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["issue", "signal", "discovery-evidence"] },
        "signal": { "$ref": "contribution-signal.schema.json" },
        "verification": {
          "type": "object",
          "required": ["status", "provider", "reference", "verified_at", "host", "repository", "repository_id", "record_type", "number", "url", "visibility"],
          "properties": {
            "status": { "const": "verified" },
            "provider": { "const": "github" },
            "reference": { "type": "string", "minLength": 1 },
            "verified_at": { "type": "string", "minLength": 1 },
            "host": { "const": "github.com" },
            "repository": { "type": "string", "minLength": 1 },
            "repository_id": { "type": "integer", "exclusiveMinimum": 0 },
            "record_type": { "const": "issue" },
            "number": { "type": "integer", "minimum": 1 },
            "url": { "type": "string", "minLength": 1 },
            "visibility": { "const": "public" },
            "state": { "type": ["string", "null"] },
            "state_reason": { "type": ["string", "null"] },
            "locked": { "type": ["boolean", "null"] },
            "labels": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "contract": { "$ref": "contribution-contract.schema.json" },
    "ai_assistance": { "$ref": "ai-assistance.schema.json" },
    "policy": { "type": "object" },
    "review": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": { "enum": ["standard", "heightened", "learning"] },
        "signals": { "type": "array" },
        "hard_stops": { "type": "array" }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "required": ["comparison", "base_tip_sha", "merge_base_sha", "head_sha", "subject_digest", "fingerprint_algorithm", "changed_files", "additions", "deletions"],
      "properties": {
        "comparison": { "const": "merge_base" },
        "base_tip_sha": { "type": "string", "minLength": 1 },
        "merge_base_sha": { "type": "string", "minLength": 1 },
        "head_sha": { "type": "string", "minLength": 1 },
        "subject_digest": { "type": "string", "minLength": 1 },
        "fingerprint_algorithm": { "const": "git-raw-content-v1" },
        "changed_files": { "type": "array", "items": { "type": "string" } },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["plan", "plan_digest", "receipts"],
      "properties": {
        "plan": {
          "type": "object",
          "required": ["plan_version", "checks"],
          "properties": {
            "plan_version": { "const": "0.1" },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "argv", "cwd", "required"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                  "cwd": { "type": "string", "minLength": 1 },
                  "required": { "type": "boolean" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "plan_digest": { "type": "string", "minLength": 1 },
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["receipt_version", "check_id", "plan_digest", "subject_digest", "argv", "cwd", "exit_code", "command_outcome", "integrity_status", "head_sha", "head_sha_before", "head_sha_after", "worktree_clean_before", "worktree_clean_after", "provenance"],
            "properties": {
              "receipt_version": { "const": "0.3" },
              "check_id": { "type": "string", "minLength": 1 },
              "plan_digest": { "type": "string", "minLength": 1 },
              "subject_digest": { "type": "string", "minLength": 1 },
              "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "cwd": { "type": "string", "minLength": 1 },
              "exit_code": { "type": "integer" },
              "head_sha": { "type": "string", "minLength": 1 },
              "head_sha_before": { "type": "string", "minLength": 1 },
              "head_sha_after": { "type": "string", "minLength": 1 },
              "worktree_clean_before": { "type": "boolean" },
              "worktree_clean_after": { "type": "boolean" },
              "command_outcome": { "enum": ["passed", "failed"] },
              "integrity_status": { "enum": ["stable", "invalid"] },
              "started_at": { "type": "string", "minLength": 1 },
              "finished_at": { "type": "string", "minLength": 1 },
              "failure_reason": { "type": "string", "minLength": 1 },
              "stdout_sha256": { "type": "string", "minLength": 1 },
              "stderr_sha256": { "type": "string", "minLength": 1 },
              "provenance": { "const": "contributor_local" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ownership": {
      "type": "object",
      "required": ["status", "problem", "scope", "verification", "risks"],
      "properties": {
        "status": { "enum": ["passed", "failed", "blocked", "unknown", "not_run"] },
        "problem": { "type": "string" },
        "scope": { "type": "string" },
        "verification": { "type": "string" },
        "risks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "snapshots": {
      "type": "object",
      "required": ["semantic"],
      "properties": { "semantic": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "results": { "type": "array", "minItems": 7 },
    "understanding": { "$ref": "understanding.schema.json" },
    "candidate_selection": {
      "type": "object",
      "required": ["candidate_id", "repository", "menu_snapshot", "recommendation", "confirmed"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "menu_snapshot": { "type": "string", "minLength": 1 },
        "recommendation": { "enum": ["plan_directly", "seek_maintainer_signal", "issue_only", "do_not_contribute"] },
        "duplicate_disposition": { "enum": ["exact_duplicate", "potential_duplicate", "related", "not_duplicate", "stale", "superseded"] },
        "transition": {
          "type": "object",
          "required": ["from", "to", "reason", "human_confirmed"],
          "properties": {
            "from": { "enum": ["seek_maintainer_signal", "issue_only"] },
            "to": { "const": "plan_directly" },
            "reason": { "type": "string", "minLength": 1 },
            "human_confirmed": { "const": true }
          },
          "additionalProperties": true
        },
        "confirmed": { "const": true }
      },
      "additionalProperties": true
    },
    "narrative": {
      "type": "object",
      "required": ["title", "body", "final_preview_confirmed", "human_expression_required", "human_expression"],
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "final_preview_confirmed": { "type": "boolean" },
        "human_expression_required": { "type": "boolean" },
        "human_expression": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "entry": { "properties": { "mode": { "const": "discovery" } } } } },
      "then": {
        "properties": {
          "basis": { "properties": { "kind": { "enum": ["signal", "discovery-evidence"] }, "signal": { "$ref": "contribution-signal.schema.json" } }, "required": ["signal"] }
        }
      }
    },
    {
      "if": { "properties": { "basis": { "properties": { "kind": { "enum": ["signal", "discovery-evidence"] } } } } },
      "then": { "properties": { "basis": { "required": ["signal"] } } }
    }
  ],
  "additionalProperties": false
}
