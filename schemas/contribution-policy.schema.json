{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewworthy.dev/schemas/contribution-policy.schema.json",
  "title": "Reviewworthy contribution policy",
  "type": "object",
  "properties": {
    "ai": {
      "type": "object",
      "properties": {
        "allowed": { "type": "boolean" },
        "disclosure_required": { "type": "boolean" },
        "disclosure_locations": { "type": "array", "items": { "enum": ["pr_body", "commit_message", "commit_trailer", "issue_body", "checklist", "other"] } },
        "disclosure_stages": { "type": "array", "items": { "enum": ["repository_orientation", "candidate_triage", "design", "implementation", "verification", "narrative", "review_response"] } }
      },
      "additionalProperties": false
    },
    "contribution": {
      "type": "object",
      "properties": {
        "issue_required": { "type": "boolean" },
        "discovery_evidence_allowed": { "type": "boolean" },
        "good_first_issue_ai_allowed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "pr": {
      "type": "object",
      "properties": {
        "human_narrative_required": { "type": "boolean" },
        "draft_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "private_reporting_required": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
