{
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "origin": {
      "enum": [
        "offline_simulation",
        "external_observer"
      ]
    },
    "trace_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "files": {
          "type": "object"
        }
      },
      "required": [
        "commit",
        "files"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "enum": [
              "RW-P01",
              "RW-P02",
              "RW-P03",
              "RW-P04"
            ]
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "diff": {
            "type": "object"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sequence": {
                  "type": "integer",
                  "minimum": 0
                },
                "kind": {
                  "enum": [
                    "action_check",
                    "readiness_check",
                    "pending_validated",
                    "identity_check",
                    "marker_search",
                    "write_ahead_pending",
                    "create_attempt",
                    "create_result",
                    "read_object",
                    "write_blocked",
                    "inspection"
                  ]
                },
                "data": {
                  "type": "object"
                }
              },
              "required": [
                "sequence",
                "kind",
                "data"
              ],
              "additionalProperties": false
            }
          },
          "create_attempts": {
            "type": "integer",
            "minimum": 0
          },
          "state_before": {
            "enum": [
              "none",
              "pending"
            ]
          },
          "state_after": {
            "enum": [
              "none",
              "pending",
              "succeeded"
            ]
          },
          "operation_preserved": {
            "type": "boolean"
          },
          "operation": {
            "type": "object"
          },
          "remote": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "action_result": {
            "type": "object",
            "properties": {
              "conclusion": {
                "enum": [
                  "success",
                  "failure"
                ]
              },
              "violation_codes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "conclusion",
              "violation_codes"
            ],
            "additionalProperties": false
          },
          "original_inputs": {
            "type": "object",
            "required": [
              "packet",
              "repo",
              "kind",
              "title",
              "body",
              "base",
              "head"
            ],
            "additionalProperties": false,
            "properties": {
              "packet": {
                "type": "object"
              },
              "repo": {
                "type": "string"
              },
              "kind": {
                "const": "issue"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "base": {
                "type": "string"
              },
              "head": {
                "type": "null"
              }
            }
          },
          "packet_semantic_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "case_id",
          "input_sha256",
          "diff",
          "events",
          "create_attempts",
          "state_before",
          "state_after"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4
    }
  },
  "required": [
    "version",
    "origin",
    "trace_sha256",
    "evaluator",
    "cases"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewworthy.dev/schemas/pilot-log.schema.json"
}
