{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewworthy.dev/schemas/project-brief.schema.json",
  "title": "Reviewworthy deterministic project brief",
  "type": "object",
  "required": ["brief_version", "generated_by", "status", "repository", "sources", "tooling", "policy", "human_sections", "source_manifest_sha256"],
  "properties": {
    "brief_version": { "const": "0.1" },
    "generated_by": { "const": "reviewworthy" },
    "status": { "const": "source-manifest-only" },
    "repository": {
      "type": "object",
      "required": ["provider", "host", "owner", "name", "repository_id", "default_branch", "base_sha"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "host": { "type": "string" },
        "owner": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "repository_id": { "type": ["integer", "null"], "exclusiveMinimum": 0 },
        "default_branch": { "type": "string", "minLength": 1 },
        "base_sha": { "type": "string" },
        "remote": { "type": "string" }
      },
      "additionalProperties": true
    },
    "focus": { "type": "array", "items": { "type": "string" } },
    "focus_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/).+" },
          "kind": { "const": "focus" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/).+" },
          "kind": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "tooling": { "type": "object", "required": ["files", "test_paths", "entrypoint_hints"], "properties": { "files": { "type": "array" }, "test_paths": { "type": "array" }, "entrypoint_hints": { "type": "array" } }, "additionalProperties": true },
    "policy": { "type": "object", "required": ["result", "posture", "unknown_claims", "hard_stops"], "properties": { "result": { "type": "string" }, "posture": { "type": "string" }, "unknown_claims": { "type": "array" }, "hard_stops": { "type": "array" } }, "additionalProperties": true },
    "human_sections": { "type": "object" },
    "source_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
